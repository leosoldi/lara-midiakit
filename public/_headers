# Arquivos com hash no nome (Vite): o nome muda quando o conteúdo muda,
# então podem ficar em cache para sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fotos, vídeos e posters. Não têm hash no nome, mas raramente mudam —
# 30 dias. Ao TROCAR uma mídia, use um nome de arquivo novo
# (ex.: video-1b.mp4) para o navegador buscar a versão nova na hora.
/media/*
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=2592000
