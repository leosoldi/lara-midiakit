# Arquivos com hash no nome (Vite): o nome muda quando o conteúdo muda,
# então podem ficar em cache para sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fotos e vídeos não têm hash no nome. Um dia de cache acelera bastante
# sem travar a troca de mídia por muito tempo.
/media/*
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400
